{
  "name": "f1-simulation",
  "version": "1.0.0",
  "description": "Simulador de F1 con Matter.js y Socket.io",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lobby": "tsx src/LobbyServer.ts",
	"build:server": "tsc",
    "build:client": "tsc --project tsconfig.client.json",
    "start-all": "concurrently \"npm run lobby\" \"npm run dev\"",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "matter-js": "^0.19.0",
    "save-dev": "^0.0.1-security",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0"
  }
}
